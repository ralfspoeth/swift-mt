<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ralfspoeth</groupId>
        <artifactId>plumbum</artifactId>
        <version>3.0.2</version>
    </parent>

    <groupId>io.github.ralfspoeth.xldr</groupId>
    <artifactId>swift-mt</artifactId>
    <version>0.1-SNAPSHOT</version>


    <scm>
        <url>scm:git:https://github.com/ralfspoeth/swift-mt</url>
        <developerConnection>scm:git:https://github.com/ralfspoeth/swift-mt.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.ralfspoeth.xldr</groupId>
            <artifactId>ia</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- only the integration test drives the server; the adapter itself
             knows nothing about it -->
        <dependency>
            <groupId>io.github.ralfspoeth.xldr</groupId>
            <artifactId>server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.ralfspoeth.xldr</groupId>
                <artifactId>bom</artifactId>
                <version>0.24</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <!--
                    No version and no executions: the parent pins 3.5.5 and
                    already binds integration-test and verify. Pinning 3.5.2 here
                    cost four rounds of debugging - that version forks with
                    JarManifestForkConfiguration and builds no module path at
                    all, so every xldr jar landed in the unnamed module, every
                    provides clause went unread, and the server could not find a
                    spec reader. Surefire, on the parent's 3.5.5, used
                    ModularClasspathForkConfiguration and was fine, which is why
                    the unit tests passed while the integration tests did not.
                -->
                <configuration>
                    <!-- one line on purpose: the value is not trimmed, and a path
                         with a newline in it is silently unopenable -->
                    <systemPropertyVariables>
                        <java.util.logging.config.file>${project.build.testOutputDirectory}/logging.properties</java.util.logging.config.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>